# Build-only adaptation: never edit a fetched/local shared JUCE checkout.
find_package(Python3 REQUIRED COMPONENTS Interpreter)
set(_cs80_mirror_script "${CMAKE_CURRENT_SOURCE_DIR}/scripts/patch-juce-state-mirror.py")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_cs80_mirror_script}")
get_target_property(_cs80_mirror_sources juce_audio_processors INTERFACE_SOURCES)
set(_cs80_mirror_replaced)
set(_cs80_mirror_count 0)
foreach(_cs80_source IN LISTS _cs80_mirror_sources)
    get_filename_component(_cs80_name "${_cs80_source}" NAME)
    if(_cs80_name STREQUAL "juce_audio_processors.cpp" OR _cs80_name STREQUAL "juce_audio_processors.mm")
        get_filename_component(_cs80_module_dir "${_cs80_source}" DIRECTORY)
        set(_cs80_generated "${CMAKE_CURRENT_BINARY_DIR}/cs80-state-mirror/${_cs80_name}")
        execute_process(COMMAND "${Python3_EXECUTABLE}" "${_cs80_mirror_script}"
            "${_cs80_source}" "${_cs80_generated}"
            RESULT_VARIABLE _cs80_result ERROR_VARIABLE _cs80_error)
        if(NOT _cs80_result EQUAL 0)
            message(FATAL_ERROR "CS-80 parameter mirror bridge review required: ${_cs80_error}")
        endif()
        foreach(_cs80_input juce_audio_processors.cpp juce_audio_processors.mm utilities/juce_AudioProcessorValueTreeState.cpp)
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_cs80_module_dir}/${_cs80_input}")
        endforeach()
        # Resolve all unchanged module-relative includes from the pristine source.
        target_include_directories(juce_audio_processors INTERFACE "${_cs80_module_dir}" "${CMAKE_CURRENT_SOURCE_DIR}/src")
        list(APPEND _cs80_mirror_replaced "${_cs80_generated}")
        math(EXPR _cs80_mirror_count "${_cs80_mirror_count} + 1")
    else()
        list(APPEND _cs80_mirror_replaced "${_cs80_source}")
    endif()
endforeach()
if(NOT _cs80_mirror_count EQUAL 1)
    message(FATAL_ERROR "CS-80 mirror bridge requires exactly one reviewed JUCE module translation unit")
endif()
set_property(TARGET juce_audio_processors PROPERTY INTERFACE_SOURCES "${_cs80_mirror_replaced}")
