+#pragma once
+#include "core/Vca.h"
+#include "core/Ig00156Batch.h"
+#include <bit>
+#if CS80_IG00156_EXACT_BATCH_BUILD
+#include <immintrin.h>
+#endif
+namespace cs80::research {
+static inline bool tryPanPair(float a,float b,float& al,float& ar,float& bl,float& br) noexcept {
+#if CS80_IG00156_EXACT_BATCH_BUILD
+ const bool finiteA=(std::bit_cast<unsigned>(a)&0x7f800000u)!=0x7f800000u;
+ const bool finiteB=(std::bit_cast<unsigned>(b)&0x7f800000u)!=0x7f800000u;
+ if(finiteA && finiteB && (_mm_getcsr()&0x1f80u)==0x1f80u){
+  const float p=std::clamp(a,-1.0f,1.0f),q=std::clamp(b,-1.0f,1.0f);
+  const __m128 x=_mm_setr_ps(1.0f-p,1.0f+p,1.0f-q,1.0f+q);
+  float out[4];_mm_storeu_ps(out,_mm_mul_ps(_mm_set1_ps(.5f),_mm_sqrt_ps(x)));
+  al=out[0];ar=out[1];bl=out[2];br=out[3];return true;
+ }
+#endif
+ return false;
+}
+static inline bool panPair(float a,float b,float& al,float& ar,float& bl,float& br) noexcept {
+ if(tryPanPair(a,b,al,ar,bl,br))return true;
+ constantPowerPan(a,al,ar);constantPowerPan(b,bl,br);return false;
+}
