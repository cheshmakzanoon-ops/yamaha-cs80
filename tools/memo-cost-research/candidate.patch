+float Engine::PitchPowMemo::hz(float note, float tuningRef, bool bypass) noexcept
+{
+#if CS80_IG00156_EXACT_BATCH_BUILD && defined(CS80_EXPERIMENTAL_PITCH_MEMO_SSE_LIBM) && defined(__linux__) && defined(__GLIBC__)
+    if (!bypass)
+    {
+        const unsigned context = _mm_getcsr() & ~0x3fu;
+        if ((context & 0x7f80u) == 0x1f80u)
+        {
+            const float exponent = (note - 69.0f) / 12.0f;
+            const auto key = std::bit_cast<std::uint32_t>(exponent);
+            if ((key & 0x7fffffffu) <= 0x42f00000u) // finite |exponent| <= 120
+            {
+                // Opt-in is limited to a separately established SSE-only powf
+                // implementation and errno-safe finite-normal domain. A hit
+                // cannot suppress any previously observed pow sticky bit.
+                if (valid && key == exponentBits && context == control
+                    && (_mm_getcsr() & stickyMask) == stickyMask)
+                    return tuningRef * value;
+                const float computed = std::pow(2.0f, exponent);
+                const auto magnitude = std::bit_cast<std::uint32_t>(computed) & 0x7fffffffu;
+                if (magnitude >= 0x00800000u && magnitude < 0x7f800000u)
+                {
+                    exponentBits = key;
+                    control = context;
+                    stickyMask = _mm_getcsr() & 0x3fu;
+                    value = computed;
+                    valid = true;
+                }
+                return tuningRef * computed;
+            }
+        }
+    }
+#else
+    (void) bypass;
+#endif
+    return midiToHz(note, tuningRef);
+}
