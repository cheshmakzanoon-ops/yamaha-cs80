+ using Memo=Engine::PitchPowMemo;
+ static bool any(const Engine& e){for(const auto& v:e.voices)for(const auto& r:v.ranks)if(r.pitchPow.valid)return true;return false;}
+ static void seed(Engine& e){for(auto& v:e.voices)for(auto& r:v.ranks){r.pitchPow.valid=true;r.pitchPow.value=1;r.pitchPow.exponentBits=0;r.pitchPow.control=0x1f80;}}
+};}
