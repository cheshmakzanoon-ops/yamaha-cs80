+static int checks=0,fails=0;
+void check(bool x,const char* why){++checks;if(!x){if(fails++<12)std::cerr<<why<<'\n';}}
+__attribute__((noinline,noipa,noclone)) float raw(float n,float t){return cs80::midiToHz(n,t);}
+__attribute__((noinline,noipa,noclone)) float cached(Memo& m,float n,float t,bool b){return m.hz(n,t,b);}
+uint32_t bits(float x){return std::bit_cast<uint32_t>(x);}
+void compare(Memo& m,float n,float ref,bool bypass,unsigned env){
+ _mm_setcsr(env);errno=EDOM;const float a=raw(n,ref);const unsigned af=_mm_getcsr();const int ae=errno;
