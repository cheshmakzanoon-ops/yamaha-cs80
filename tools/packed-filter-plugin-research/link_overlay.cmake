# Preparation-only Linux map overlay; use CMAKE_PROJECT_TOP_LEVEL_INCLUDES.
# Does not change compile flags, definitions, optimization or environment.
if(CMAKE_VERSION VERSION_LESS "3.24")
  message(FATAL_ERROR "Research map overlay requires CMake >= 3.24")
endif()
get_property(_cs80_map_queued GLOBAL PROPERTY CS80_RESEARCH_MAP_OVERLAY_QUEUED)
if(_cs80_map_queued)
  message(FATAL_ERROR "Research map overlay applied twice")
endif()
set_property(GLOBAL PROPERTY CS80_RESEARCH_MAP_OVERLAY_QUEUED TRUE)

function(_cs80_research_reject_map value origin)
  if("${value}" MATCHES "(^|[^A-Za-z0-9_])(-Map|--Map|(-M|--print-map|--cref)([^A-Za-z0-9_]|$))")
    message(FATAL_ERROR "Preexisting research map flag in ${origin}")
  endif()
endfunction()

function(_cs80_research_check_directory directory)
  get_directory_property(_variables DIRECTORY "${directory}" VARIABLES)
  foreach(_variable IN LISTS _variables)
    if(_variable MATCHES "^CMAKE_.*FLAGS")
      get_directory_property(_value DIRECTORY "${directory}" DEFINITION "${_variable}")
      _cs80_research_reject_map("${_value}" "directory ${directory} variable ${_variable}")
    endif()
  endforeach()
  set(_configurations DEBUG RELEASE RELWITHDEBINFO MINSIZEREL ${CMAKE_CONFIGURATION_TYPES} "${CMAKE_BUILD_TYPE}")
  foreach(_property LINK_OPTIONS LINK_LIBRARIES)
    get_property(_value DIRECTORY "${directory}" PROPERTY "${_property}")
    _cs80_research_reject_map("${_value}" "directory ${directory} ${_property}")
  endforeach()
  get_property(_targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  get_property(_imported DIRECTORY "${directory}" PROPERTY IMPORTED_TARGETS)
  foreach(_target IN LISTS _targets _imported)
    foreach(_property LINK_OPTIONS INTERFACE_LINK_OPTIONS LINK_FLAGS LINK_LIBRARIES INTERFACE_LINK_LIBRARIES)
      get_target_property(_value "${_target}" "${_property}")
      _cs80_research_reject_map("${_value}" "target ${_target} ${_property}")
    endforeach()
    foreach(_configuration IN LISTS _configurations)
      string(TOUPPER "${_configuration}" _configuration)
      get_target_property(_value "${_target}" "LINK_FLAGS_${_configuration}")
      _cs80_research_reject_map("${_value}" "target ${_target} LINK_FLAGS_${_configuration}")
    endforeach()
  endforeach()
  get_property(_children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(_child IN LISTS _children)
    _cs80_research_check_directory("${_child}")
  endforeach()
endfunction()

function(_cs80_research_apply_maps)
  if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR NOT CMAKE_CXX_COMPILER_ID MATCHES "^(GNU|Clang)$")
    message(FATAL_ERROR "Research map overlay supports Linux GNU/Clang only")
  endif()
  file(REAL_PATH "${CMAKE_BINARY_DIR}" _canonical_build)
  if(NOT _canonical_build STREQUAL CMAKE_BINARY_DIR OR "${_canonical_build}" MATCHES "[,;\n\r$<>]")
    message(FATAL_ERROR "Research map overlay requires canonical safe build path")
  endif()
  get_cmake_property(_variables VARIABLES)
  foreach(_variable IN LISTS _variables)
    if(_variable MATCHES "^CMAKE_.*FLAGS")
      _cs80_research_reject_map("${${_variable}}" "variable ${_variable}")
    endif()
  endforeach()
  _cs80_research_check_directory("${CMAKE_SOURCE_DIR}")
  foreach(_target CS80Reference_VST3 CS80Reference_Standalone)
    if(NOT TARGET "${_target}")
      message(FATAL_ERROR "Missing required research map target ${_target}")
    endif()
    get_target_property(_alias "${_target}" ALIASED_TARGET)
    get_target_property(_imported "${_target}" IMPORTED)
    get_target_property(_type "${_target}" TYPE)
    if(_alias OR _imported OR NOT _type MATCHES "^(EXECUTABLE|MODULE_LIBRARY|SHARED_LIBRARY)$")
      message(FATAL_ERROR "Unsupported research map target ${_target}")
    endif()
  endforeach()
  foreach(_target CS80Reference_VST3 CS80Reference_Standalone)
    target_link_options("${_target}" PRIVATE "-Wl,-Map,${_canonical_build}/${_target}.research.map,--cref")
  endforeach()
endfunction()
cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL _cs80_research_apply_maps)
