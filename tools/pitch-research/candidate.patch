+// Experimental bounded-fidelity pitch path. Public/Legacy midiToHz is unchanged.
+// Local vendor-libm samples are not an all-input equivalence proof.
+float sourcePitchHz(float note, float tuningRef) noexcept
+{
+#if CS80_IG00156_EXACT_BATCH_BUILD
+    if ((_mm_getcsr() & 0x7f80u) == 0x1f80u)
+    {
+        const float exponent = (note - 69.0f) / 12.0f;
+        if (std::isfinite(exponent) && exponent >= -120.0f && exponent <= 120.0f)
+            return tuningRef * std::exp2(exponent);
+    }
+#endif
+    return midiToHz(note, tuningRef);
+}
