+
+bool Engine::isExperimentalVoiceContinuityActive() const noexcept
+{
+    return experimentalProfile.enabled && global.renderPolicy == RenderPolicy::sourcePerformance;
+}
+
+bool Engine::setExperimentalVoiceContinuity(
+    const experimental::ExperimentalVoiceContinuityProfile& profile) noexcept
+{
+    if (!profile.valid()) return false; // entire transaction before any mutation
+    if (profile == experimentalProfile) return true;
+    const bool wasActive = isExperimentalVoiceContinuityActive();
+    experimentalProfile = profile;
+    if (wasActive || isExperimentalVoiceContinuityActive())
+    {
+        reset();
+        fxDampL.reset();
+        fxDampR.reset();
+        applyParams(params);
+    }
+    return true;
+}
+
+experimental::ContinuousVoiceCircuit::State
+Engine::getExperimentalVoiceCircuitState(int voice) const noexcept
+{
+    if (!isExperimentalVoiceContinuityActive() || voice < 0 || voice >= kNumVoices) return {};
+    return experimentalCircuits[(size_t) voice].getState();
+}
+
+void Engine::resetExperimentalCircuits() noexcept
+{
+    Rng phases(experimentalProfile.phaseSeed), noiseSeeds(experimentalProfile.idleNoiseSeed);
+    experimentalRejectedSamples = 0;
+    for (int vi = 0; vi < kNumVoices; ++vi)
+    {
+        auto& v = voices[(size_t) vi];
+        // Fields previously overwritten only on assignment now feed cold circuits.
+        v.note = experimentalProfile.coldMidiNote;
+        v.midiChannel = 1;
+        v.velocity = v.pressure = v.timbre = v.mpeBend = 0.0f;
+        v.glidePitch = v.targetPitch = (float) v.note;
+        v.ribbonRatio = 1.0f;
+        v.contour = keyboardContourWeights(v.note);
+        for (auto& rank : v.ranks) rank.info = {};
+        experimentalCircuits[(size_t) vi].prepare(internalRate,
+            experimentalProfile.initialKeyVolts, { phases.nextUnipolar(), phases.nextUnipolar() });
+        for (auto& rng : experimentalIdleNoise[(size_t) vi]) rng = Rng(noiseSeeds.nextUInt());
+    }
 }
 
