+    }
+    static double maximumFrequencyHz(const O& self) noexcept { return std::min(.45*self.rate,.95/self.profile.resetSecondsNominal); }
+#if defined(__GNUC__)
+    __attribute__((noinline,noclone))
+#endif
+    static WscOutputVolts terminal(O& self,double inverseTauSamples,
+                                  double weightedArea,double weightedMoment) noexcept {
+        auto after=nodes(self,1);
+        self.state.elapsedSeconds+=self.dt;
+        self.endNodes=after;self.endNodesValid=true;
+        const auto& raw=self.endNodes;
+        self.diagnostics.rawPin7Volts=raw.pin7;self.diagnostics.coupledInputVolts=raw.u;
+        self.diagnostics.trianglePin3Volts=raw.triangle;self.diagnostics.shaperInputVolts=raw.w;self.diagnostics.raw=raw.ungatedValue;
+        WscOutputVolts output;
+        double* destinations[3]={&output.sawPin5,&output.pulsePin7,&output.sinePin2};
