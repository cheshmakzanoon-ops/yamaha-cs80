+    }
+};
+bool wscImmediateScalarEnvironmentSupported() noexcept {
+#if WSC_IMMEDIATE_EXACT_BUILD
+    unsigned csr;unsigned short cw;
+    asm volatile("stmxcsr %0":"=m"(csr));
+    asm volatile("fnstcw %0":"=m"(cw));
+    const auto control=csr&0xffc0u;
+    return cw==0x037fu&&(control==0x1f80u||control==0x9fc0u);
+#else
+    return false;
+#endif
+}
+WscOutputVolts tickWscImmediateScalar(ReconstructedOscillator& self,double requestedHz,
+                                    const WscControls& controls) noexcept {
+    using O=ReconstructedOscillator;using Nodes=O::Nodes;using B=WscImmediateScalarBackend;
+
+        self.diagnostics.eventCount=0;
+        if(!self.basis)return {}; // never prepared (self.basis pool exhausted at construction)
+        const double inverseTauSamples=self.basis->inverseTauSamples,weightedArea=self.basis->weightedArea,weightedMoment=self.basis->weightedMoment;
+        Nodes before;
+        double f=self.state.heldFrequencyHz,threshold=self.state.heldThresholdVolts;
+        if(std::isfinite(requestedHz)){f=std::clamp(requestedHz,0.,B::maximumFrequencyHz(self));if(f!=requestedHz)self.diagnostics.frequencyLimited=true;}
+        else self.diagnostics.invalidControl=true;
+        if(std::isfinite(controls.pulseThresholdVolts))threshold=controls.pulseThresholdVolts;
+        else self.diagnostics.invalidControl=true;
+        // Control changes. A full event (branch residuals) is recorded unless the
+        // change provably or negligibly alters no branch:
+        // - exact: a threshold move that does not cross the comparator input
+        //   leaves every branch unchanged; a frequency change during the reset
+        //   plateau changes only the charge self.rate, which no branch reads;
+        // - bounded: a frequency change whose slope corner adds less than
+        //   O::kNegligibleCornerVolts (see below) keeps the new frequency but omits
+        //   that corner's antialias residual.
+        const bool gates=controls.sawEnabled!=self.state.sawEnabled||controls.pulseEnabled!=self.state.pulseEnabled;
+        bool event=gates,refresh=gates||!self.endNodesValid;
+        if(f!=self.state.heldFrequencyHz&&self.state.resetRemainingSeconds==0.){
+            if(self.negligibleCornerScale*std::abs(f-self.state.heldFrequencyHz)<O::kNegligibleCornerVolts)refresh=true;
+            else event=refresh=true;
+        }
+        if(threshold!=self.state.heldThresholdVolts&&!event){
+            const double u=(self.state.resetRemainingSeconds>0.?self.profile.resetVoltsNominal:self.converterGain*self.state.charge)-self.state.inputBaselineVolts;
+            const double a=u-self.state.heldThresholdVolts,b=u-threshold;
+            if((a>0.)!=(b>0.)||std::abs(a)<1e-9||std::abs(b)<1e-9)event=refresh=true;
+        }
