#############################################
# Rule for running custom commands.

rule CUSTOM_COMMAND
  command = $COMMAND
  description = $DESC


#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = /workspace/scratch/ee447c520988/pitch-power-recovery/tools/cmake/data/bin/cmake --regenerate-during-build -S/workspace/scratch/ee447c520988/sixteen-note-release-impl -B/workspace/scratch/ee447c520988/build-sixteen-release-profile-gcc-generic
  description = Re-running CMake...
  generator = 1


#############################################
# Rule for cleaning all built files.

rule CLEAN
  command = /workspace/scratch/ee447c520988/pitch-power-recovery/tools/bin/ninja $FILE_ARG -t clean $TARGETS
  description = Cleaning all built files...


