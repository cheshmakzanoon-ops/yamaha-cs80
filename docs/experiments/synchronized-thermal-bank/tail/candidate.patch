+#if CS80_RESEARCH_SYNCHRONIZED_THERMAL_BANK
+// Research-only: one time base for an entire engine's lockstep thermal bank.
+class SharedThermalClock {
+public:
+    void prepare(int period) noexcept { periodSamples=period; elapsed=0; valid=false; }
+    template<class Visit> void tick(Visit visit) noexcept {
+        const bool advance=++elapsed>=periodSamples;
+        if(advance) elapsed=0;
+        const unsigned csr=_mm_getcsr();
+        // On this SSE2 engine, normal-range double->float casts may raise only
+        // precision. Do not elide when they could change exception state, trap,
+        // or see a different rounding or denormal mode from the stored floats.
+        if(!advance && valid && (csr&0xffc0u)==control && (csr&0x1f80u)==0x1f80u && (csr&0x20u)!=0) return;
+        bool ordinary=true;
+        visit([&](ThermalDrift& source,float& destination){
+            const double d=advance?source.advance():source.heldCents();
+            const auto magnitude=std::bit_cast<std::uint64_t>(d)&0x7fffffffffffffffull;
+            ordinary &= magnitude==0 || (magnitude>=(std::uint64_t(1023-80)<<52) && magnitude<=(std::uint64_t(1023+80)<<52));
+            destination=static_cast<float>(d);
+        });
+        valid=ordinary;control=csr&0xffc0u;
+    }
+private:
+    int periodSamples=960,elapsed=0; bool valid=false; unsigned control=0;
+};
+#endif
 } // namespace cs80::tolerance
