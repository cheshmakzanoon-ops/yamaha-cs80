@@ -0,0 +1,4 @@
+#include <cstdint>
+namespace { std::uint64_t counts[3]{}; }
+extern "C" __attribute__((noinline,visibility("default"))) void cs80_mirror_observer_event(unsigned event) noexcept { if(event<3) ++counts[event]; }
+extern "C" __attribute__((noinline,visibility("default"))) void cs80_mirror_observer_snapshot(std::uint64_t* out) noexcept { for(unsigned n=0;n<3;++n)out[n]=counts[n]; }
