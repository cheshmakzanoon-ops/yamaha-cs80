+#if CS80_RESEARCH_SHARED_READOUT_RETENTION
+// Noinline plus the explicit input/output memory operands prevents the observed
+// FP status from floating across the original scalar solve in this qualification.
+[[gnu::noinline]] Engine::SharedReadoutUpdate Engine::updateSourceSharedReadout(
+    const source_factory::BothRankDrives& drives) noexcept
+{
+    auto& memo = sourceSharedMemo;
+    if (global.renderPolicy != RenderPolicy::sourcePerformance)
+    {
+        invalidateSourceSharedReadout();
+        return source_factory::evaluateShared(sourceBoundaries, global.resonance, drives, sourceShared)
+            ? SharedReadoutUpdate::solved : SharedReadoutUpdate::failed;
+    }
+    const auto bits = [](double value) { return std::bit_cast<std::uint64_t>(value); };
+    // Z is used by Shared only for validation and saturation. The admission
+    // predicate is integer-only, rejects denormals/nonfinite/out-of-range Z,
+    // and never substitutes a new saturation or sanitization law.
+    bool ordinaryZ = true;
+    for (const auto& rank : drives)
+        for (const auto& d : rank)
+        {
+            const auto magnitude = bits(d.filterEnvelopeZ) & UINT64_C(0x7fffffffffffffff);
+            ordinaryZ &= magnitude == 0
+                || (magnitude >= UINT64_C(0x0010000000000000)
+                    && magnitude <= UINT64_C(0x4008000000000000));
+        }
+    const double resonance = global.resonance;
+    bool same = memo.valid && ordinaryZ && memo.resonanceBits == bits(resonance);
+    for (std::size_t rank = 0; same && rank < kNumRanks; ++rank)
+        for (std::size_t voice = 0; same && voice < kNumVoices; ++voice)
+            same = memo.touchBits[rank][voice][0] == bits(drives[rank][voice].velocity)
+                && memo.touchBits[rank][voice][1] == bits(drives[rank][voice].pressure);
+    unsigned before;
+    asm volatile("stmxcsr %0" : "=m"(before)
+        : "m"(drives), "m"(sourceBoundaries), "m"(sourceShared), "m"(resonance) : "memory");
+    constexpr unsigned controlMask = 0xffc0u, statusMask = 0x3fu, masks = 0x1f80u;
+    const bool masked = (before & masks) == masks;
+    if (same && masked && (before & controlMask) == (memo.postCsr & controlMask)
+        && ((before & statusMask) & (memo.postCsr & statusMask)) == (memo.postCsr & statusMask))
+        return SharedReadoutUpdate::retained;
+    const bool success = source_factory::evaluateShared(sourceBoundaries, resonance, drives, sourceShared);
+    unsigned after;
+    asm volatile("stmxcsr %0" : "=m"(after) : "m"(sourceShared) : "memory");
+    memo.valid = success && ordinaryZ && masked && (before & controlMask) == (after & controlMask);
+    if (memo.valid)
+    {
+        for (std::size_t rank = 0; rank < kNumRanks; ++rank)
+            for (std::size_t voice = 0; voice < kNumVoices; ++voice)
+                memo.touchBits[rank][voice] = { bits(drives[rank][voice].velocity), bits(drives[rank][voice].pressure) };
+        memo.resonanceBits = bits(resonance);
+        memo.postCsr = after;
+    }
+    return success ? SharedReadoutUpdate::solved : SharedReadoutUpdate::failed;
+}
