+std::uint64_t bits(double x) noexcept { return std::bit_cast<std::uint64_t>(x); }
+bool sameProfile(const OscillatorNominalProfile& a,const OscillatorNominalProfile& b) noexcept {
+    const std::array<double,9> aa{a.resetSecondsNominal,a.referenceHzNominal,a.resetVoltsNominal,a.resetExcessVoltsNominal,a.couplingSecondsNominal,a.triangleSpanVoltsNominal,a.sliceVoltsInferred,a.pulseHalfSpanVoltsInferred,a.sineGainVoltsInferred};
+    const std::array<double,9> bb{b.resetSecondsNominal,b.referenceHzNominal,b.resetVoltsNominal,b.resetExcessVoltsNominal,b.couplingSecondsNominal,b.triangleSpanVoltsNominal,b.sliceVoltsInferred,b.pulseHalfSpanVoltsInferred,b.sineGainVoltsInferred};
+    for(std::size_t i=0;i<aa.size();++i)if(bits(aa[i])!=bits(bb[i]))return false;
+    for(std::size_t i=0;i<a.shaperOrdinateInferred.size();++i)if(bits(a.shaperOrdinateInferred[i])!=bits(b.shaperOrdinateInferred[i]))return false;
+    return true;
+}
+}
+bool WscNodeKernelAccess::prepare(const Owners& owners,Prepared& destination) noexcept {
+    const OscillatorNominalProfile nominal{};
+    for(std::size_t i=0;i<owners.size();++i){
+        if(!owners[i]||!owners[i]->basis||!sameProfile(owners[i]->profile,nominal))return false;
+        for(std::size_t j=0;j<i;++j)if(owners[i]==owners[j])return false;
+        if(i && (bits(owners[i]->converterGain)!=bits(owners[0]->converterGain)
+              ||bits(owners[i]->rampHalf)!=bits(owners[0]->rampHalf)))return false;
+    }
+    Prepared next;next.owners=owners;next.profile=owners[0]->profile;
+    next.converterGain=owners[0]->converterGain;next.rampHalf=owners[0]->rampHalf;next.valid=true;
+    destination=next;return true;
+}
