+#include "Engine.h"
+#include "WscNodeRenderSpan.h"
+
+namespace cs80 {
+void Engine::render(float* interleavedStereo, int numFrames, const float* externalMono)
+{
+    if (interleavedStereo == nullptr || numFrames <= 0)
+        return;
+
+#if CS80_IG00156_EXACT_BATCH_BUILD && WSC_NODE_EXACT_BUILD
+    if (filterBatchKernel==nullptr || !wscTerminalStagingEligible(0.0f)
+        || !WscNodeKernelAccess::environmentSupported())
+    { renderStockWscFallback(interleavedStereo,numFrames,externalMono);return; }
+    auto kernel=selectWscNodeKernel();
+    if(kernel==nullptr) { renderStockWscFallback(interleavedStereo,numFrames,externalMono);return; }
+    WscNodeRenderSpan localSpan;localSpan.kernel=kernel;
+    bool any=false;
+    for(unsigned group=0;group<4;++group){
+        WscNodeKernelAccess::Owners owners{};
+        for(unsigned lane=0;lane<4;++lane){const auto rank=group*4+lane;owners[lane]=&voices[rank/2].ranks[rank%2].wsc;}
+        const bool ok=WscNodeKernelAccess::prepare(owners,localSpan.prepared[group]);any|=ok;
+    }
+    if(!any) { renderStockWscFallback(interleavedStereo,numFrames,externalMono);return; }
+    externalInput.setConnected(externalMono != nullptr);
+    for (int i = 0; i < numFrames; ++i)
+    {
+        const auto external = externalInput.tick(externalMono != nullptr ? externalMono[i] : 0.0f);
+        float lastL = 0.0f, lastR = 0.0f;
+        const int retainedPhase = decL.getRetainedPhase();
+        for (int os = 0; os < oversample; ++os)
+        {
+            float l = 0.0f, r = 0.0f;
+            const float ext=external[(size_t) os];
+            // Same dispatch intersection as original. No standalone oscillator path is forced
+            // when filters, voice policy, event/rate or the actual FP controls declined.
+            const bool enabledFilter=rankSettings[0].hpfOn||rankSettings[1].hpfOn
+                                    ||rankSettings[0].lpfOn||rankSettings[1].lpfOn;
+            if (filterBatchKernel!=nullptr && usesSourceModels(global.renderPolicy)
+                && Ig00156Batch::environmentSupported() && enabledFilter
+                && wscTerminalStagingEligible(ext))
+                processInternalSampleWscTerminalStagedWithSpan(l,r,ext,&localSpan);
+            else
+                processInternalSample(l,r,ext);
+            decL.push(l);
+            decR.push(r);
+            // Evaluate only the retained last phase, using symmetric tap pairs.
+            if (os == retainedPhase)
+            {
+                lastL = decL.output();
+                lastR = decR.output();
+            }
+        }
+        interleavedStereo[i * 2] = lastL;
+        interleavedStereo[i * 2 + 1] = lastR;
+    }
+#else
+    renderStockWscFallback(interleavedStereo,numFrames,externalMono);
+#endif
+}
+}
