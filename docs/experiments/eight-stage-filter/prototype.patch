+#include <bit>
+#include <cstdint>
+#include <immintrin.h>
+
+// The translation unit is compiled with contraction disabled, but NOT with a
+// global AVX target. Only these functions may contain AVX instructions.
+#define CS80_AVX512 __attribute__((target("avx2,avx512f,avx512vl,avx512dq,no-fma")))
+#define CS80_AVX512_INLINE CS80_AVX512 __attribute__((always_inline)) inline
+
+namespace cs80
+{
+namespace
+{
+struct V
+{
+    __m512d x;
+    CS80_AVX512_INLINE V() : x(_mm512_setzero_pd()) {}
+    CS80_AVX512_INLINE V(double a) : x(_mm512_set1_pd(a)) {}
+    CS80_AVX512_INLINE V(__m512d a) : x(a) {}
+    friend CS80_AVX512_INLINE V operator+(V a, V b) { return _mm512_add_pd(a.x,b.x); }
+    friend CS80_AVX512_INLINE V operator-(V a, V b) { return _mm512_sub_pd(a.x,b.x); }
+    friend CS80_AVX512_INLINE V operator*(V a, V b) { return _mm512_mul_pd(a.x,b.x); }
+    friend CS80_AVX512_INLINE V operator/(V a, V b) { return _mm512_div_pd(a.x,b.x); }
+};
+CS80_AVX512_INLINE V select(V mask,V yes,V no) { return _mm512_mask_blend_pd(_mm512_movepi64_mask(_mm512_castpd_si512(mask.x)),no.x,yes.x); }
+CS80_AVX512_INLINE V absolute(V x) { return _mm512_andnot_pd(_mm512_set1_pd(-0.0),x.x); }
+CS80_AVX512_INLINE V less(V a,V b) { return _mm512_castsi512_pd(_mm512_movm_epi64(_mm512_cmp_pd_mask(a.x,b.x,_CMP_LT_OQ))); }
+CS80_AVX512_INLINE V greater(V a,V b) { return _mm512_castsi512_pd(_mm512_movm_epi64(_mm512_cmp_pd_mask(a.x,b.x,_CMP_GT_OQ))); }
+CS80_AVX512_INLINE __m512i outsideStateBound(V value)
+{
+    const auto magnitude=_mm512_and_si512(_mm512_castpd_si512(value.x),
+                                          _mm512_set1_epi64(0x7fffffffffffffffLL));
+    return _mm512_movm_epi64(_mm512_cmpgt_epi64_mask(magnitude,
+        _mm512_set1_epi64(std::bit_cast<std::int64_t>(1024.0))));
+}
+CS80_AVX512_INLINE V tanh(V original)
+{
+    // The scalar branches do not evaluate the polynomial outside its clamp.
+    const V x=select(greater(absolute(original),4.97),0.0,original);
+    const V x2=x*x;
+    V result=x*(135135.0+x2*(17325.0+x2*(378.0+x2)))
+                /(135135.0+x2*(62370.0+x2*(3150.0+x2*28.0)));
+    result=select(greater(original,4.97),1.0,result);
+    return select(less(original,-4.97),-1.0,result);
+}
+
+// Bit inspection cannot raise invalid for a signaling NaN. These are
+// optimization eligibility limits, NOT clamps: outside them scalar behavior
+// is retained. The tested physical stage domain is much smaller.
+bool bounded(double x,double limit) noexcept
+{
+    return (std::bit_cast<std::uint64_t>(x)&0x7fffffffffffffffULL)
+        <= std::bit_cast<std::uint64_t>(limit);
+}
+bool bounded(float x,float limit) noexcept
+{
+    return (std::bit_cast<std::uint32_t>(x)&0x7fffffffU)
+        <= std::bit_cast<std::uint32_t>(limit);
+}
+} // namespace
+
+struct Ig00156EightAccess
+{
+    static bool eligible(const Ig00156Eight::Stages& stages,
+                         const Ig00156Eight::Inputs& input) noexcept
+    {
+        // Nearest rounding and masked traps only. Never change FTZ/DAZ or
+        // clear existing status flags. Arithmetic may raise sticky flags;
+        // exact flag equality with the scalar calculation is not promised.
+        if (!Ig00156Eight::environmentSupported()) return false;
+        for(std::size_t i=0;i<8;++i)
+        {
+            const auto& s=*stages[i];
+            if(!bounded(input[i],64.0f) || !bounded(s.lastRate,1536000.0f)
+               || s.lastRate<8000.0f || s.lastUnwarped || !s.cutoffCoefficientsValid)
+                return false;
+            for(double value : {s.inputScale,s.gmPart,s.ffPart,s.xFromFb,s.xFromIn,
+                                 s.xFromU,s.xFromBp,s.kiGs,s.invA11,s.inFromX})
+                if(!bounded(value,1000000.0)) return false;
+            // Positive physical gains make both Newton denominators >= 1.
+            // Arbitrary restored slopes/custom networks must not turn a
+            // discarded vector lane into a division by zero. These are still
+            // eligibility checks: unsupported states keep the scalar solver.
+            if(s.gmPart<0.0 || s.ffPart<0.0 || s.xFromBp < -1.0)
+                return false;
+        }
+        return true;
+    }
+
+    static CS80_AVX512 bool process(const Ig00156Eight::Stages& stages,
+                                  const Ig00156Eight::Inputs& input,
+                                  Ig00156Eight::Outputs& output) noexcept
+    {
+        for (std::size_t i=0;i<8;++i) {
+            if(stages[i]==nullptr) return false;
+            for (std::size_t j=0;j<i;++j) if(stages[i]==stages[j]) return false;
+        }
+        if(!eligible(stages,input)) return false;
+        const auto gather=[&](double Ig00156Stage::*member) CS80_AVX512 {
+            return V(_mm512_setr_pd(stages[0]->*member,stages[1]->*member,
+                                   stages[2]->*member,stages[3]->*member,
+                                   stages[4]->*member,stages[5]->*member,stages[6]->*member,stages[7]->*member));
+        };
+        const V scale=gather(&Ig00156Stage::inputScale);
+        const V g1=gather(&Ig00156Stage::gmPart),f1=gather(&Ig00156Stage::ffPart),g2=g1,f2=f1;
+        const V fromFb=gather(&Ig00156Stage::xFromFb),fromIn=gather(&Ig00156Stage::xFromIn);
+        const V fromU=gather(&Ig00156Stage::xFromU),fromBp=gather(&Ig00156Stage::xFromBp);
+        const V kiGs=gather(&Ig00156Stage::kiGs),invA11=gather(&Ig00156Stage::invA11),inFromX=gather(&Ig00156Stage::inFromX);
+        const V zIn=gather(&Ig00156Stage::zIn),zFb=gather(&Ig00156Stage::zFb);
+        const V zBp=gather(&Ig00156Stage::zBp),zLp=gather(&Ig00156Stage::zLp);
+        const V slope1=gather(&Ig00156Stage::slope1),slope2=gather(&Ig00156Stage::slope2);
+        // Reuse gathered state for the dynamic admission gate. Integer bit
+        // comparisons reject NaN (including signalling NaN) and infinities
+        // without evaluating them or altering any authoritative state.
+        auto bad=_mm512_or_si512(outsideStateBound(zIn),outsideStateBound(zFb));
+        bad=_mm512_or_si512(bad,outsideStateBound(zBp));
+        bad=_mm512_or_si512(bad,outsideStateBound(zLp));
+        bad=_mm512_or_si512(bad,outsideStateBound(slope1));
+        bad=_mm512_or_si512(bad,outsideStateBound(slope2));
+        if(_mm512_movepi64_mask(bad)!=0) return false;
+        // Bounds above prove both slope vectors finite before FP comparisons.
+        auto badSlope=_mm512_or_pd(less(slope1,0.0).x,greater(slope1,1.0).x);
+        badSlope=_mm512_or_pd(badSlope,less(slope2,0.0).x);
+        badSlope=_mm512_or_pd(badSlope,greater(slope2,1.0).x);
+        if(_mm512_movepi64_mask(_mm512_castpd_si512(badSlope))!=0) return false;
+
+        const V u=V(_mm512_setr_pd(input[0],input[1],input[2],input[3],input[4],input[5],input[6],input[7]))*scale;
+        const V level=kIg00156OtaLevel,inv=1.0/kIg00156OtaLevel;
+        const V x0=fromFb*zFb+fromIn*zIn+fromU*u;
+        const V c0=2.0*x0-zLp,c1=2.0*(fromBp+1.0);
+        const V e1=g1*slope1+f1,e2=g2*slope2+f2;
+        V bp=(zBp-e1*c0)/(1.0+e1*(c1+e2)),hp,t1,t2;
+        V active=_mm512_castsi512_pd(_mm512_set1_epi64(-1));
+        for(int iteration=0;;++iteration)
+        {
+            const V nextT2=tanh(bp*inv);
+            const V nextHp=c0+c1*bp+g2*level*nextT2+f2*bp;
+            const V nextT1=tanh(nextHp*inv);
+            t2=select(active,nextT2,t2);hp=select(active,nextHp,hp);t1=select(active,nextT1,t1);
+            const V f=bp-zBp+g1*level*t1+f1*hp;
+#if CS80_ENABLE_EXPERIMENTAL_FILTER_RECOVERY
+            if(iteration==4) {
+                // No histories have been written yet. Let the caller redo all
+                // lanes through the authoritative scalar recovery path.
+                const V failed=_mm512_andnot_pd(less(absolute(f),1.0e-7).x,active.x);
+                if(_mm512_movepi64_mask(_mm512_castpd_si512(failed.x))!=0) return false;
+                break;
+            }
+#else
+            if(iteration==4) break;
+#endif
+            active=_mm512_andnot_pd(less(absolute(f),1.0e-7).x,active.x);
+            if(_mm512_movepi64_mask(_mm512_castpd_si512(active.x))==0) break;
+            const V dh=c1+g2*(1.0-t2*t2)+f2;
+            // Inactive lanes must not evaluate an unused hazardous division.
+            const V numerator=select(active,f,0.0);
+            const V denominator=select(active,1.0+(g1*(1.0-t1*t1)+f1)*dh,1.0);
+            bp=select(active,bp-numerator/denominator,bp);
+        }
+        const V lp=zLp-g2*level*t2-f2*bp;
+        const V x=x0+fromBp*bp;
+        const V vin=(zIn+kiGs*u-kiGs*bp)*invA11-inFromX*x;
+        const V use1=greater(absolute(hp*inv),1.0e-9),use2=greater(absolute(bp*inv),1.0e-9);
+        const V newSlope1=select(use1,t1/select(use1,hp*inv,1.0),1.0);
+        const V newSlope2=select(use2,t2/select(use2,bp*inv,1.0),1.0);
+        const auto scatter=[&](double Ig00156Stage::*member,V value) CS80_AVX512 {
+            alignas(64) double values[8];_mm512_store_pd(values,value.x);
+            for(std::size_t i=0;i<8;++i)stages[i]->*member=values[i];
+        };
+        scatter(&Ig00156Stage::zIn,2.0*vin-zIn);scatter(&Ig00156Stage::zFb,2.0*x-zFb);
+        scatter(&Ig00156Stage::zBp,2.0*bp-zBp);scatter(&Ig00156Stage::zLp,2.0*lp-zLp);
+        scatter(&Ig00156Stage::vIn,vin);scatter(&Ig00156Stage::vFb,x);
+        scatter(&Ig00156Stage::vBp,bp);scatter(&Ig00156Stage::vLp,lp);
+        scatter(&Ig00156Stage::slope1,newSlope1);scatter(&Ig00156Stage::slope2,newSlope2);
+        alignas(64) double l[8],h[8],b[8];
+        _mm512_store_pd(l,lp.x);_mm512_store_pd(h,hp.x);_mm512_store_pd(b,bp.x);
+        for(std::size_t i=0;i<8;++i)
+            output[i]={static_cast<float>(l[i]),static_cast<float>(h[i]),static_cast<float>(-b[i])};
+        return true;
+    }
+};
+
+Ig00156Eight::Kernel Ig00156Eight::selectKernel(bool allowAcceleration) noexcept
+{
+    if(!allowAcceleration) return nullptr;
+    __builtin_cpu_init();
+    return __builtin_cpu_supports("avx2") && __builtin_cpu_supports("avx512f")
+        && __builtin_cpu_supports("avx512vl") && __builtin_cpu_supports("avx512dq")
+        ? &Ig00156EightAccess::process : nullptr;
+}
+bool Ig00156Eight::environmentSupported() noexcept
+{
+    unsigned short cw; asm volatile("fnstcw %0" : "=m"(cw));
+    if(cw!=0x037f) return false;
+    const auto csr=_mm_getcsr();
+    return (csr & 0x6000U) == 0 && (csr & 0x1f80U) == 0x1f80U;
+}
+} // namespace cs80
+#else
+namespace cs80
+{
+Ig00156Eight::Kernel Ig00156Eight::selectKernel(bool) noexcept { return nullptr; }
+bool Ig00156Eight::environmentSupported() noexcept { return false; }
+}
+#endif
