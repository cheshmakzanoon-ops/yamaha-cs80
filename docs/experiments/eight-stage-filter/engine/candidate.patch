+                // lanes through the authoritative scalar recovery path.
+                const V failed=_mm512_andnot_pd(less(absolute(f),1.0e-7).x,active.x);
+                if(_mm512_movepi64_mask(_mm512_castpd_si512(failed.x))!=0) return false;
+                break;
+            }
+#else
+            if(iteration==4) break;
+#endif
+            active=_mm512_andnot_pd(less(absolute(f),1.0e-7).x,active.x);
+            if(_mm512_movepi64_mask(_mm512_castpd_si512(active.x))==0) break;
