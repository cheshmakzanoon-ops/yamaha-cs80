+#include "core/Ig00156Eight.h"
+#include <cstdint>
+namespace {std::uint64_t counts[3]{};}
+namespace cs80 {
+extern "C" __attribute__((noinline)) void filterEightObserve(unsigned success,const Ig00156Eight::Stages&) noexcept {++counts[0];counts[1]+=success!=0;}
+extern "C" __attribute__((noinline)) void filterEightConsumed() noexcept {++counts[2];}
+}
+extern "C" __attribute__((noinline,visibility("default"))) void filterEightNativeCounts(std::uint64_t* out) noexcept {for(unsigned i=0;i<3;++i)out[i]=counts[i];}
