  "description_changes": [
    {
      "index": 12,
      "name": "Brass Ensemble 16",
      "before": "A weighty 16' body under an 8' section, with restrained chorus for ensemble width. The upper rank enters a little later and stays lighter than the foundation.",
      "after": "A weighty 16' body under an 8' section, spread gently in stereo beneath restrained chorus. The upper rank enters a little later and stays lighter than the foundation."
    },
    {
      "index": 79,
      "name": "Neo-Noir Pad",
      "before": "A dark saw foundation supports a later pulse glow, broad chorus and a faint slow ring beat. Long, unequal releases leave a warm cinematic tail after the upper color recedes.",
      "after": "A dark saw foundation supports a later pulse glow, a broad stereo field, chorus and a faint slow ring beat. Long, unequal releases leave a warm cinematic tail after the upper color recedes."
    },
    {
      "index": 89,
      "name": "Arctic Pad",
      "before": "A thin, bright 8' saw band supports a quiet 4' pulse sheen. Distinct high-pass bands and later upper entry create an icy texture; moderate chorus supplies width.",
      "after": "A thin, bright 8' saw band supports a quiet 4' pulse sheen. Distinct high-pass bands and later upper entry create an icy texture; gently spread ranks supply stereo width under moderate chorus."
    },
    {
      "index": 106,
      "name": "Synthwave Chords",
      "before": "Detuned saw chords have a bright opening accent and broad chorus. The second rank sustains more softly and releases sooner, preserving a warm center in the longer retro tail.",
      "after": "Detuned saw chords spread across stereo with a bright opening accent and chorus. The second rank sustains more softly and releases sooner, preserving a warm center in the longer retro tail."
    },
    {
      "index": 272,
      "name": "UFO Landing",
      "before": "A low sine body follows repeating downward SUB glides while the ring carrier settles after each note. A shorter upper pulse edge marks the start of the landing sweep.",
      "after": "A low sine body follows repeating downward SUB glides while the shared ring carrier settles over the phrase. Release all keys and any sustain hold before the next attack to restart that sweep; a shorter upper pulse edge marks each note."
    }
  ],
