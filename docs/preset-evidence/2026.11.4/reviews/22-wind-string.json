  "analysis_script": "from pathlib import Path\nimport numpy as np, struct, csv, json, hashlib\nROOT=Path('/workspace/scratch/a9592b052b11/a22')\ndef wav(p):\n b=p.read_bytes();at=12;data=None\n while at+8<=len(b):\n  tag,length=struct.unpack_from('<4sI',b,at);at+=8\n  if tag==b'fmt ':fmt=struct.unpack_from('<HHIIHH',b,at)\n  if tag==b'data':data=b[at:at+length]\n  at+=length+(length&1)\n assert fmt[0]==3 and fmt[1]==2 and fmt[2]==48000\n return np.frombuffer(data,dtype='<f4').reshape(-1,2).astype(float)\ndef features(p,note,start=.35,end=1.3):\n y=wav(p);x=y[int(start*48000):int(end*48000)].mean(axis=1)\n f0=440*2**((note-69)/12);nfft=1<<int(np.ceil(np.log2(len(x)*8)))\n f=np.fft.rfftfreq(nfft,1/48000);s=np.abs(np.fft.rfft(x*np.hanning(len(x)),nfft))**2\n ix=np.where((f>.985*f0)&(f<1.015*f0))[0];k=ix[np.argmax(s[ix])]\n log=np.log(np.maximum(s[k-1:k+2],1e-100));d=.5*(log[0]-log[2])/(log[0]-2*log[1]+log[2]);pitch=(k+d)*48000/nfft\n power=np.array([s[abs(f-h*pitch)<2.4].sum() for h in range(1,25)])\n db=lambda v:10*np.log10(max(float(v),1e-100))\n return {'pitch_hz':pitch,'pitch_cents':1200*np.log2(pitch/f0),'rms_dbfs':20*np.log10(np.sqrt(np.mean(x*x))), 'upper_to_fund_db':db(power[3:16].sum()/power[0]),'even_to_odd_db':db(power[1:14:2].sum()/power[:15:2].sum()),'harmonic_fraction':(power/power.sum()).tolist(),'peak_dbfs':20*np.log10(abs(y).max()),'finite':bool(np.isfinite(y).all()),'overload_samples':int((abs(y)>1).sum())}\ndef file_for(folder,name):\n rows=list(csv.DictReader((folder/'metrics.csv').open()));row=next(r for r in rows if r['name']==name)\n candidates=list(folder.glob(row['index']+'-*.wav'));assert len(candidates)==1\n return candidates[0]\nnotes={'Solo Violin':60,'Solo Cello':72,'Oboe':60,'English Horn':60,'Clarinet':60,'Bass Clarinet':72}\nrecords={}\nfor name,key in notes.items():\n records[name]={}\n for v in (.3,.85):records[name][str(v)]=features(file_for(ROOT/f'c4-{key}-{v}',name),60)\npairs=[]\nfor a,b in [('Solo Violin','Solo Cello'),('Oboe','English Horn'),('Clarinet','Bass Clarinet')]:\n vals=[]\n for v in ('0.3','0.85'):\n  x=records[a][v];y=records[b][v]\n  vals.append({'velocity':float(v),'normalized_harmonic_total_variation':float(.5*np.abs(np.array(x['harmonic_fraction'])-np.array(y['harmonic_fraction'])).sum()),'upper_balance_difference_db':y['upper_to_fund_db']-x['upper_to_fund_db'],'pitch_difference_cents':y['pitch_cents']-x['pitch_cents']})\n pairs.append({'programs':[a,b],'measurements':vals})\neffort={n:{'firm_soft_upper_balance_change_db':r['0.85']['upper_to_fund_db']-r['0.3']['upper_to_fund_db'],'firm_soft_level_db':r['0.85']['rms_dbfs']-r['0.3']['rms_dbfs'],'max_abs_pitch_error_cents':max(abs(v['pitch_cents']) for v in r.values())} for n,r in records.items()}\nregister={}\nfor name,offset in [('Clarinet',0),('Bass Clarinet',-12)]:\n rows=[]\n for key in [56,60,62,64,66,68,70,74]:rows.append({'played_key':key,'sounding_note':key+offset,**features(file_for(ROOT/f'register-{key}',name),key+offset,.3,1.2)})\n steps=[(b['even_to_odd_db']-a['even_to_odd_db'])/(b['played_key']-a['played_key']) for a,b in zip(rows,rows[1:])]\n register[name]={'points':rows,'max_absolute_even_odd_change_db_per_semitone':max(abs(x) for x in steps),'max_abs_pitch_error_cents':max(abs(x['pitch_cents']) for x in rows)}\nreport={'analysis':'Full-preset spectra, fixed 48 kHz and zero pressure; harmonic ratios and normalized harmonic fractions remove level scale. The complete preset comparison does not isolate body size.','c4_conditions':records,'paired_preset_distinction':pairs,'effort':effort,'register':register}\n(ROOT/'analysis.json').write_text(json.dumps(report,indent=2)+'\\n')\nprint(json.dumps({'pairs':pairs,'effort':effort,'register_summary':{k:{a:b for a,b in v.items() if a!='points'} for k,v in register.items()}},indent=2))\n"
}
