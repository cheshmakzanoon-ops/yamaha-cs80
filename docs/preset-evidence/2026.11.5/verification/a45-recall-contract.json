    {
      "id": "fresh_instance",
      "finding": "Constructor calls applyFreshInstancePatch; curated index 0 resolves to host 222 Brass Swell I. A later host/session restore can replace it.",
      "anchors": [
        "src/plugin/PluginProcessor.cpp::Cs80AudioProcessor",
        "src/plugin/PluginProcessor.cpp::applyFreshInstancePatch",
        "tests/ProgramLibraryHostTests.h::testProgramLibraryHost"
      ]
    },
    {
      "id": "stable_catalogue",
      "finding": "523 existing entries; original 0\u2013221 and later 222\u2013522. Factory browsing is distinct from user files.",
      "anchors": [
        "src/core/FactoryPresets.cpp::programLibrary",
        "src/plugin/PresetBrowser.cpp::refresh"
      ]
    },
    {
      "id": "session_recall",
      "finding": "setStateInformation restores normalized serialized controls, name/index and A/B data; it never calls loadFactoryPreset to substitute current factory values.",
      "anchors": [
        "src/plugin/PluginProcessor.cpp::setStateInformation",
        "src/plugin/PluginProcessor.cpp::setPresetMetadata"
      ]
    },
    {
      "id": "explicit_load",
      "finding": "LOAD, list Enter, search Enter and double-click reach loadSelected/loadEntry/loadFactoryPreset without an already-loaded short circuit.",
      "anchors": [
        "src/plugin/PresetBrowser.cpp::loadSelected",
        "src/plugin/PresetBrowser.cpp::loadEntry",
        "src/plugin/PluginProcessor.cpp::loadFactoryPreset"
      ]
    },
    {
      "id": "audition_guard",
      "finding": "Automatic audition skips a row already identified as loaded, protecting live edits; search/filter/restore selection does not audition.",
      "anchors": [
        "src/plugin/PresetBrowser.cpp::selectedRowsChanged",
        "src/plugin/PresetBrowser.cpp::listBoxItemClicked",
        "src/plugin/PresetBrowser.cpp::setAudition",
        "tests/PresetClickTests.h"
      ]
    },
    {
      "id": "origin_not_name",
      "finding": "Serialized session recall has unknown runtime origin; syncLoaded uses exact runtime origin and factory index/file, never a name guess. LOAD may be shown instead of RELOAD for an old same-name session.",
      "anchors": [
        "src/plugin/PresetOrigin.h",
        "src/plugin/PresetBrowser.cpp::syncLoaded",
        "src/plugin/PresetBrowser.cpp::updateLoadLabel",
        "tests/PresetIdentityTests.h"
      ]
    },
    {
      "id": "user_name_collision",
      "finding": "A same-name saved user patch stays a separate file; FACTORY LIBRARY avoids selecting that saved recipe by mistake.",
      "anchors": [
        "src/plugin/PresetBrowser.cpp::loadEntry",
        "src/plugin/PluginProcessor.cpp::loadUserPreset",
        "tests/PresetIdentityTests.h"
      ]
    },
    {
      "id": "panel_sources",
      "finding": "Factory recall calls applyValues with resetSources=true, selecting PANEL on both ranks so saved hardware/memory selection cannot suppress the new factory bodies.",
      "anchors": [
        "src/plugin/PluginProcessor.h::applyValues",
        "src/plugin/PluginProcessor.cpp::applyValues",
        "src/plugin/PluginProcessor.cpp::resetHardwareSources"
      ]
    },
    {
      "id": "setup_retention",
      "finding": "Factory recall preserves physical setup/session parameters while replacing sound parameters, including all 12 body controls. It is not a reset of the entire instrument or host.",
      "anchors": [
        "src/plugin/PluginProcessor.cpp::isPhysicalSetupParameter",
        "src/plugin/PluginProcessor.cpp::applyValues",
        "tests/InstrumentBodyHostTests.h"
      ]
    },
    {
      "id": "next_note",
      "finding": "Body model, decay, size, variant and articulation are captured at accepted note onset; body mix and brightness remain live. Existing voices are not rebuilt just by loading or editing selectors.",
      "anchors": [
        "src/core/Engine.cpp::startVoice",
        "src/core/Engine.cpp::processInternalSample",
        "tests/InstrumentBodyHostTests.h"
      ]
    },
    {
      "id": "pre_body_defaults",
      "finding": "Missing body fields use declared defaults: models/mixes 0, brightness 0.5, decay 1, sizes 1, variants 0. They do not inherit the receiving live body.",
      "anchors": [
        "src/plugin/PluginProcessor.cpp::normaliseRestoredState",
        "src/core/Params.h",
        "tests/InstrumentBodyHostTests.h"
      ]
    },
    {
      "id": "preceding_variants",
      "finding": "A prior size-aware ten-control patch retains those fields and defaults only the two absent variants to Standard, whether session or user preset.",
      "anchors": [
        "src/plugin/PluginProcessor.cpp::normaliseRestoredState",
        "src/plugin/PluginProcessor.cpp::loadUserPreset",
        "tests/InstrumentBodyHostTests.h"
      ]
    },
    {
      "id": "inactive_ab",
      "finding": "An inactive saved A/B slot completes missing fields from their declared defaults independently of the live slot; toggling A/B recalls its saved sound rather than the newest factory recipe.",
      "anchors": [
        "src/plugin/PluginProcessorLibrary.cpp::readLibraryState",
        "src/plugin/PluginProcessorLibrary.cpp::recallAbSnapshot",
        "tests/InstrumentBodyHostTests.h"
      ]
    },
    {
      "id": "revert",
      "finding": "REVERT restores the captured opening sound, including saved controls/sources/memories/modern configuration; it can restore an older recipe.",
      "anchors": [
        "src/plugin/PresetBrowser.cpp::captureOpening",
        "src/plugin/PresetBrowser.cpp::revertToOpening",
        "src/plugin/PluginProcessor.cpp::restorePresetBrowserSound",
        "tests/PresetRevertTests.h"
      ]
    },
    {
      "id": "retained_modern_routes",
      "finding": "Factory recall need not erase stored MSEG shapes/routing: all 16 factory matrix amounts are zero in every 523-program vector, and ModernLayer::rebuild excludes zero-amount slots.",
      "anchors": [
        "src/plugin/PluginProcessor.cpp::applyValues",
        "src/core/Engine.cpp::buildSettings",
        "src/core/ModernLayer.h::rebuild",
        "docs/preset-evidence/2026.11.5/inventory.json"
      ]
    },
    {
      "id": "thread_and_controllers",
      "finding": "GUI recall publishes APVTS controls for the next audio block; normal program recall retains held keys/controller ownership and host automation rather than resetting them. Fresh notes and an unautomated comparison instance avoid conflating these with factory data.",
      "anchors": [
        "src/plugin/PluginProcessor.cpp::applyValues",
        "src/plugin/PluginProcessorLibrary.cpp::handleProgramChange"
      ]
    },
