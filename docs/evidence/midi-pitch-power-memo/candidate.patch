+// Exact-argument memo for the existing MIDI pitch power. Rounded Float32
+// pitch often holds for several samples even during slow analog drift. Cache
+// only pow(2, exponent), so tuning-reference changes still apply immediately.
+// No pitch quantization, approximate power or altered evaluation order.
+struct MidiPitchPowerMemo
+{
+    float argument = std::numeric_limits<float>::quiet_NaN();
+    float value = 0.0f;
+    float operator()(float exponent) noexcept
+    {
+        if (!(exponent == argument))
+        {
+            argument = exponent;
+            value = std::pow(2.0f, exponent);
+        }
+        return value;
+    }
+};
+
+inline float midiToHz(float note, float tuningRef, MidiPitchPowerMemo& memo) noexcept
+{
+    return tuningRef * memo((note - 69.0f) / 12.0f);
+}
+
 // IG00156 nominal law: Yamaha CS servicing guide p34; CS-80 IC sheet p42.
 // MIDI60 / .5V is an interface reference, not a panel-slider voltage claim.
 constexpr float kReferenceKeyVolts = 0.5f;
