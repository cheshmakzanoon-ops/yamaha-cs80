diff --git a/tests/MidiPitchPowerMemoTests.cpp b/tests/MidiPitchPowerMemoTests.cpp
new file mode 100644
index 0000000..f3ab7d1
--- /dev/null
+++ b/tests/MidiPitchPowerMemoTests.cpp
@@ -0,0 +1,73 @@
+// Same-toolchain, exact Float32 pitch-power memo contract. No audio host/GUI.
+#include "core/Dsp.h"
+#include <array>
+#include <bit>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <limits>
+
+namespace {
+#if defined(_MSC_VER)
+#define NOINLINE __declspec(noinline)
+#elif defined(__GNUC__) || defined(__clang__)
+#define NOINLINE __attribute__((noinline))
+#else
+#define NOINLINE
+#endif
+NOINLINE float original(float note, float reference)
+{ return cs80::midiToHz(note, reference); }
+NOINLINE float cached(float note, float reference, cs80::MidiPitchPowerMemo& memo)
+{ return cs80::midiToHz(note, reference, memo); }
+int failures = 0;
+std::uint64_t comparisons = 0;
+void same(float expected, float actual)
+{
+    ++comparisons;
+    // A NaN's payload is not a pitch value. All other results, including
+    // infinities and signed zero, must have identical Float32 bits.
+    if (std::isnan(expected) && std::isnan(actual)) return;
+    if (std::bit_cast<std::uint32_t>(expected) != std::bit_cast<std::uint32_t>(actual))
+        if (++failures <= 8) std::printf("mismatch %.9g != %.9g\n", expected, actual);
+}
+}
+int main()
+{
+    cs80::MidiPitchPowerMemo memo;
+    std::uint32_t rng = 0x87c580u;
+    for (int i = 0; i < 1000000; ++i)
+    {
+        rng ^= rng << 13; rng ^= rng >> 17; rng ^= rng << 5;
+        const float note = float(rng % 256000) / 1000.0f - 64.0f;
+        const float adjacent = std::nextafter(note, i % 2 ? 300.0f : -300.0f);
+        for (float n : {note, note, adjacent, adjacent, note})
+            for (float reference : {440.0f, 432.0f, 444.0f})
+                same(original(n, reference), cached(n, reference, memo));
+    }
+    // Broad Float32 coverage also exercises exponent overflow/underflow and
+    // invalid values, followed by recovery to a regular pitch.
+    for (int i = 0; i < 100000; ++i)
+    {
+        rng ^= rng << 13; rng ^= rng >> 17; rng ^= rng << 5;
+        const float note = std::bit_cast<float>(rng);
+        same(original(note, 440.0f), cached(note, 440.0f, memo));
+        same(original(note, 432.0f), cached(note, 432.0f, memo));
+        same(original(69.0f, 440.0f), cached(69.0f, 440.0f, memo));
+    }
+    const float inf = std::numeric_limits<float>::infinity();
+    const float nan = std::numeric_limits<float>::quiet_NaN();
+    for (float note : {0.0f, -0.0f, 69.0f, inf, -inf, nan})
+        for (float reference : {0.0f, -0.0f, 440.0f, inf, -inf, nan})
+            for (int repeat = 0; repeat < 2; ++repeat)
+                same(original(note, reference), cached(note, reference, memo));
+    // Separate ranks and copies retain independent memo keys. Cache memory is
+    // derived, so reset/rate transitions do not require explicit invalidation.
+    auto other = memo;
+    for (int i = 0; i < 2048; ++i)
+    {
+        same(original(float(i), 440.0f), cached(float(i), 440.0f, memo));
+        same(original(float(-i), 432.0f), cached(float(-i), 432.0f, other));
+    }
+    std::printf("%llu exact comparisons, %d failures\n", (unsigned long long)comparisons, failures);
+    return failures ? 1 : 0;
+}
